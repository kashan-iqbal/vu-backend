# vu-backend environment contract — copy to .env and fill in real values.
# Variables validated at boot (src/config/env.ts) will CRASH the app if missing
# or malformed. Do NOT commit the real .env.

# --- Core ---
# In Docker, PORT is injected per blue/green color by the deploy script; locally
# it defaults to 3000.
PORT=3000
NODE_ENV=development

# --- Datastore (required) ---
DATABASE_URL=mongodb+srv://user:pass@cluster/dbname

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_EXPIRE_MINUTES=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
google_secret=

# --- LLM providers ( DEEPSEEK_API_KEY required) ---
DEEPSEEK_API_KEY=

# --- Qdrant (UNUSED in this project) ---
# Not deployed, but env.ts still validates QDRANT_URL as a required string at
# boot. Keep a harmless placeholder so the app starts; the client is never
# contacted.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- App (required) ---
# CORS origin — the frontend URL. Must be a valid URL.
FRONTEND_URL=http://localhost:3000
# Shared secret guarding admin/script write endpoints. Min 16 chars.
HANDOUT_API_KEY=

# --- Cloudflare R2 (S3-compatible) — all optional; upload route reports
#     "not configured" until every value is set ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

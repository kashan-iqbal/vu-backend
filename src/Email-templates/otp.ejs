<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <title><%= locals.heading || "Your verification code" %></title>
</head>
<body style="margin:0; padding:0; background-color:#eef2f8; font-family:'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">
  <!-- preheader (hidden) -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
    <%= locals.intro || "Use this code to continue." %> Code expires in <%= locals.expiresMinutes || 5 %> minutes.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef2f8; padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:600px; background-color:#ffffff; border-radius:14px; overflow:hidden; box-shadow:0 6px 24px rgba(15,58,125,0.10);">

          <!-- Header -->
          <tr>
            <td style="background-color:<%= primary %>; background-image:linear-gradient(135deg, <%= primary %> 0%, <%= accent %> 100%); padding:32px 30px; text-align:center;">
              <div style="font-size:26px; font-weight:700; color:#ffffff; letter-spacing:0.5px;"><%= brandName %></div>
              <div style="font-size:13px; color:#dbe6f5; margin-top:6px;"><%= tagline %></div>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:36px 36px 8px;">
              <h1 style="margin:0 0 12px; font-size:22px; font-weight:700; color:<%= primary %>; text-align:center;">
                <%= locals.heading || "Your verification code" %>
              </h1>
              <p style="margin:0; font-size:15px; line-height:1.6; color:#4a5a6a; text-align:center;">
                <%= locals.intro || "Use the verification code below to continue." %>
              </p>
            </td>
          </tr>

          <!-- OTP code -->
          <tr>
            <td style="padding:24px 36px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center">
                    <div style="display:inline-block; background-color:#f1f6fc; border:1px solid #d6e2f2; border-radius:12px; padding:18px 34px;">
                      <span style="font-size:36px; font-weight:700; letter-spacing:10px; color:<%= primary %>; font-family:'Courier New', monospace;"><%= locals.otp %></span>
                    </div>
                  </td>
                </tr>
              </table>
              <p style="margin:18px 0 0; font-size:13px; color:#8899aa; text-align:center;">
                This code expires in <strong style="color:<%= accent %>;"><%= locals.expiresMinutes || 5 %> minutes</strong>.
              </p>
            </td>
          </tr>

          <!-- Security note -->
          <tr>
            <td style="padding:8px 36px 32px;">
              <p style="margin:0; font-size:13px; line-height:1.6; color:#7a8a9a; text-align:center;">
                <%= locals.note || "If you didn't request this, you can safely ignore this email — no changes will be made to your account." %>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f7f9fc; border-top:1px solid #e8ecf2; padding:22px 30px; text-align:center;">
              <p style="margin:0 0 4px; font-size:12px; color:#9aa7b5;">
                Need help? Contact us at
                <a href="mailto:<%= supportEmail %>" style="color:<%= accent %>; text-decoration:none;"><%= supportEmail %></a>
              </p>
              <p style="margin:0; font-size:12px; color:#aab4c0;">
                &copy; <%= year %> <%= brandName %>. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
